generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  WAITING_FOR_STORE_ACCEPTANCE
  PREPARING
  READY_FOR_PICKUP
  READY_FOR_DELIVERY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

/// Where the order was taken (staff picks; customer online is forced to ORDER_CUSTOMER)
enum SalesChannel {
  STOREFRONT
  FACEBOOK
  APP_DELIVERY
  OTHER
  ORDER_CUSTOMER
}

enum StaffRole {
  SELLER
  DELIVERY
}

enum BrandMemberRole {
  OWNER
  MANAGER
}

enum PriceRange {
  UNDER_100
  FROM_101_250
  FROM_251_500
  FROM_501_1000
  OVER_1000
}

enum ExpensePaymentMode {
  IMMEDIATE
  SCHEDULED
}

enum ExpenseSchedule {
  WEEKLY
  MONTHLY
}

enum ExpensePayChannel {
  CASH
  TRANSFER
}

enum MenuPromoType {
  AMOUNT
  PERCENT
}

enum OptionGroupMode {
  MANUAL
  FROM_MENU
}

/// NORMAL = mala / queue storefront; SKEWER = skewer-prep orders only
enum BranchOperatingMode {
  NORMAL
  SKEWER
}

enum SkewerOrderStatus {
  PENDING_CONFIRM
  CONFIRMED
  CANCELLED
}

enum StockLocationType {
  WAREHOUSE
  BRANCH
}

enum StockType {
  SALE_ITEM
  CONSUMABLE
  EQUIPMENT
}

enum StockMovementType {
  RECEIVE
  STOCK_IN
  TRANSFER
  SALE
  FREE
  DAMAGE
  LOST
  ADJUST
  COUNT
  RETURN
  ISSUE
  WASTE
}

enum StockTransferStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum EquipmentStatus {
  ACTIVE
  DAMAGED
  LOST
  RETIRED
}

enum StockCountType {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum StockTransferKind {
  WAREHOUSE_TO_BRANCH
  BRANCH_TO_BRANCH
}

enum KitchenProductionStatus {
  COMPLETED
  CANCELLED
}

enum BranchStockRequestStatus {
  PENDING
  FULFILLED
  REJECTED
  CANCELLED
}

model Admin {
  id                     String             @id @default(cuid())
  username               String             @unique
  passwordHash           String
  /// AES-GCM encrypted plaintext for platform recovery/view only (never sent to brand admins)
  passwordEnc            String?
  isPlatformAdmin        Boolean            @default(false)
  /// LINE user id after admin adds the Official Account and links by one-time code
  lineUserId             String?            @unique
  lineNotifyEnabled      Boolean            @default(true)
  /// Receive per-branch operating-day summary at cutoff
  lineNotifyDailySummary Boolean            @default(true)
  /// One-time LINE link code (shown only while logged into admin)
  lineLinkCode           String?
  lineLinkCodeExpiresAt  DateTime?
  /// Pending hard-delete via LINE chat (confirm with "ยืนยัน")
  linePendingDeleteOrderId    String?
  linePendingDeleteExpiresAt  DateTime?
  /// When set (and not expired), bare order numbers enter delete preview
  lineDeleteModeExpiresAt     DateTime?
  createdAt              DateTime           @default(now())
  brandMembers           BrandMember[]
  activityLogs           AdminActivityLog[]
  stockMovements         StockMovement[]
  stockTransfers         StockTransfer[]
  stockCounts            StockCount[]
  purchaseOrders         PurchaseOrder[]
  branchExpenses         BranchExpense[]
  kitchenProductions     KitchenProduction[]
  stockRequestsHandled   BranchStockRequest[] @relation("StockRequestFulfilledBy")
  confirmedSkewerOrders  SkewerOrder[]      @relation("SkewerOrderConfirmedByAdmin")

  @@index([lineLinkCode])
}

model Brand {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  nameTh             String?
  nameEn             String?
  siteTitle          String?
  siteDescription    String?
  logoUrl            String?
  /**
   * รูปปกหัวหน้าเข้าสู่ระบบเมื่อเข้าจากลิงก์แบรนด์ (ยังไม่ระบุสาขา)
   */
  coverImageUrl      String?
  /**
   * เบอร์ติดต่อแบรนด์ (ลูกค้ากด “แจ้งให้เราทราบ” ฯลฯ)
   */
  contactPhone       String?
  color              String             @default("#dc2626")
  /// How many queue tickets to print when opening a queue (1–5). 2 = shop + customer.
  queueTicketCopies  Int                @default(1)
  /// Master switch: brand warehouse + branch stock features
  stockEnabled       Boolean            @default(false)
  /// When true, managers may push balances below zero
  allowNegativeStock Boolean            @default(false)
  createdAt          DateTime           @default(now())
  branches           Branch[]
  members            BrandMember[]
  activityLogs       AdminActivityLog[]
  products           BrandProduct[]
  stockLocations     StockLocation[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]
  stockCounts        StockCount[]
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  stockLots            StockLot[]
  kitchenProductions   KitchenProduction[]
  branchStockRequests  BranchStockRequest[]
}

/**
 * Audit trail for platform + brand admin mutations
 */
model AdminActivityLog {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  adminId       String?
  adminUsername String
  action        String
  summary       String
  brandId       String?
  brandName     String?
  branchId      String?
  branchName    String?
  entityType    String?
  entityId      String?
  entityName    String?
  metadata      Json?
  admin         Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  brand         Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([brandId, createdAt])
  @@index([branchId, createdAt])
  @@index([action, createdAt])
  @@index([adminId, createdAt])
}

model BrandMember {
  id        String          @id @default(cuid())
  adminId   String
  brandId   String
  role      BrandMemberRole @default(OWNER)
  createdAt DateTime        @default(now())
  admin     Admin           @relation(fields: [adminId], references: [id], onDelete: Cascade)
  brand     Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([adminId, brandId])
}

/// Idempotency log: one LINE daily summary push per branch operating day
model LineDailySummaryLog {
  id             String   @id @default(cuid())
  branchId       String
  operatingDay   DateTime @db.Date
  sentAt         DateTime @default(now())
  recipientCount Int      @default(0)
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, operatingDay])
  @@index([sentAt])
}

/**
 * Platform-level settings (marketplace shell). Brand identity lives on Brand.
 */
model SiteSettings {
  id                          String   @id @default("default")
  siteName                    String   @default("SkillSale")
  siteTitle                   String   @default("SkillSale - ระบบสั่งอาหารออนไลน์")
  siteDescription             String?
  /**
   * Mark / letter-style icon (square).
   */
  iconUrl                     String?
  /**
   * Full wordmark logo.
   */
  logoUrl                     String?
  faviconUrl                  String?
  primaryColor                String   @default("#0B2A4A")
  /**
   * Which asset to show: "icon" | "logo"
   */
  markSidebar                 String   @default("icon")
  markLogin                   String   @default("logo")
  markHome                    String   @default("logo")
  markOrder                   String   @default("icon")
  markFavicon                 String   @default("icon")
  /// LINE Messaging API channel access token (optional; env can override)
  lineChannelAccessToken      String?
  /// LINE Messaging API channel secret (optional; env can override)
  lineChannelSecret           String?
  /// Master switch for outbound LINE notifications
  lineMessagingEnabled        Boolean  @default(false)
  /// Notify linked branch staff when a new order arrives
  lineNotifyStaffOnNewOrder   Boolean  @default(true)
  /// Notify linked brand owners/managers with daily cutoff summary
  lineNotifyBrandDailySummary Boolean  @default(true)
  /// LINE rich menu id for linked brand admins (Messaging API)
  lineAdminRichMenuId         String?
  /// Default rich menu for guests (login / help) before admin link
  lineGuestRichMenuId         String?
  updatedAt                   DateTime @updatedAt
}

/**
 * Store type tags for branch primary/secondary category (e.g. อาหารไทย).
 */
model RestaurantType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Platform-managed staff new-order alert sounds.
 */
model AlertSound {
  id        String   @id @default(cuid())
  name      String
  fileUrl   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
}

model Branch {
  id                           String                       @id @default(cuid())
  brandId                      String?
  code                         String?
  name                         String
  nameTh                       String?
  nameEn                       String?
  imageUrl                     String?
  address                      String?
  latitude                     Float?
  longitude                    Float?
  phone                        String?
  primaryCategory              String?
  secondaryCategories          String[]                     @default([])
  priceRange                   PriceRange?
  ownerMessage                 String?
  extraMessage                 String?
  isOpen                       Boolean                      @default(true)
  /// Hidden from customer storefront; still visible in admin
  isHidden                     Boolean                      @default(false)
  /// Sandbox / QA branch for the brand — show “ทดลอง” badge; not production ops
  isTest                       Boolean                      @default(false)
  /**
   * @deprecated Prefer storefrontHours / deliveryHours
   */
  opensAt                      String?
  /**
   * @deprecated Prefer storefrontHours / deliveryHours
   */
  closesAt                     String?
  storefrontHours              Json?
  deliveryHours                Json?
  allowAdvanceOrder            Boolean                      @default(true)
  autoAcceptOrders             Boolean                      @default(false)
  /// Opt-in stock for this branch (requires brand.stockEnabled + brandId)
  stockEnabled                 Boolean                      @default(false)
  /// NORMAL = mala queue storefront; SKEWER = skewer-prep ordering only
  operatingMode                BranchOperatingMode          @default(NORMAL)
  /// Staff new-order alert sound (from platform library)
  alertSoundId                 String?
  createdAt                    DateTime                     @default(now())
  brand                        Brand?                       @relation(fields: [brandId], references: [id])
  alertSound                   AlertSound?                  @relation(fields: [alertSoundId], references: [id], onDelete: SetNull)
  staff                        Staff[]
  menuItems                    BranchMenuItem[]
  menuCategories               MenuCategory[]
  optionGroups                 BranchOptionGroup[]
  deliveryLocations            DeliveryLocation[]
  orders                       Order[]
  skewerOrders                 SkewerOrder[]
  shifts                       BranchShift[]
  shareCodes                   BranchShareCode[]
  lineDailySummaries           LineDailySummaryLog[]
  activityLogs                 AdminActivityLog[]
  stockLocations               StockLocation[]
  stockTransfersIn             StockTransfer[]              @relation("StockTransferDestination")
  stockTransfersOut            StockTransfer[]              @relation("StockTransferSource")
  stockCounts                  StockCount[]
  branchMenuItemStocks         BranchMenuItemStock[]
  branchMenuItemStockHistories BranchMenuItemStockHistory[]
  branchNonMenuItems           BranchNonMenuItem[]
  expenses                     BranchExpense[]
  stockRequests                BranchStockRequest[]

  @@unique([brandId, code])
  @@index([alertSoundId])
}

/// Staff open/close round for a branch (multiple per calendar day).
model BranchShift {
  id              String       @id @default(cuid())
  branchId        String
  /// Bangkok calendar date of this round
  calendarDate    DateTime     @db.Date
  roundNumber     Int
  openedAt        DateTime     @default(now())
  closedAt        DateTime?
  openedByStaffId String?
  closedByStaffId String?
  /// Float / change money at open (ตังทอน)
  openingCash     Decimal      @db.Decimal(10, 2)
  /// Optional note when opening the round (e.g. เงินทอนสำหรับเปิดร้าน)
  note            String?
  /// Admin cancelled this shift (void/mistake) — still shown in history, not active
  cancelledAt     DateTime?
  /// Optional reason when admin cancels the shift
  cancelNote      String?
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedByStaff   Staff?       @relation("ShiftOpenedByStaff", fields: [openedByStaffId], references: [id], onDelete: SetNull)
  closedByStaff   Staff?       @relation("ShiftClosedByStaff", fields: [closedByStaffId], references: [id], onDelete: SetNull)
  orders          Order[]
  stockCounts     StockCount[]
  expenses        BranchExpense[]

  @@unique([branchId, calendarDate, roundNumber])
  @@index([branchId, closedAt])
  @@index([branchId, calendarDate])
}

model Staff {
  id                           String                       @id @default(cuid())
  branchId                     String
  phone                        String                       @unique
  name                         String?
  gender                       String?
  age                          Int?
  imageUrl                     String?
  isActive                     Boolean                      @default(true)
  /// LINE user id after staff adds the Official Account and links by phone
  lineUserId                   String?                      @unique
  lineNotifyEnabled            Boolean                      @default(true)
  createdAt                    DateTime                     @default(now())
  branch                       Branch                       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roles                        StaffRoleAssignment[]
  createdOrders                Order[]                      @relation("OrderCreatedByStaff")
  openedShifts                 BranchShift[]                @relation("ShiftOpenedByStaff")
  closedShifts                 BranchShift[]                @relation("ShiftClosedByStaff")
  receivedTransfers            StockTransfer[]              @relation("StockTransferReceivedBy")
  stockMovements               StockMovement[]              @relation("StockMovementByStaff")
  stockCounts                  StockCount[]                 @relation("StockCountByStaff")
  branchMenuItemStockHistories BranchMenuItemStockHistory[]
  branchNonMenuItemHistories   BranchNonMenuItemHistory[]
  expenses                     BranchExpense[]
  stockRequests                BranchStockRequest[]
}

model StaffRoleAssignment {
  id      String    @id @default(cuid())
  staffId String
  role    StaffRole
  staff   Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, role])
}

model BranchMenuItem {
  id                           String                       @id @default(cuid())
  branchId                     String
  name                         String
  /// Delivery channel price (base)
  price                        Decimal                      @db.Decimal(10, 2)
  /// Pickup channel price; null = same as delivery price
  pickupPrice                  Decimal?                     @db.Decimal(10, 2)
  /// Storefront/reference price only (not ordered online); null = same as delivery
  storefrontPrice              Decimal?                     @db.Decimal(10, 2)
  sellDelivery                 Boolean                      @default(true)
  sellPickup                   Boolean                      @default(true)
  sellStorefront               Boolean                      @default(true)
  promoEnabled                 Boolean                      @default(false)
  promoType                    MenuPromoType?
  promoValue                   Decimal?                     @db.Decimal(10, 2)
  promoContinuous              Boolean                      @default(false)
  promoStartsAt                DateTime?
  promoEndsAt                  DateTime?
  description                  String?
  categoryId                   String?
  imageUrl                     String?
  isHidden                     Boolean                      @default(false)
  /// Hidden from staff keyed-order menu (still visible to customers unless isHidden)
  hideFromStaff                Boolean                      @default(false)
  isOutOfStock                 Boolean                      @default(false)
  /// Link to brand SKU for quantity stock (null = manual sold-out only)
  brandProductId               String?
  sortOrder                    Int                          @default(0)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  branch                       Branch                       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category                     MenuCategory?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandProduct                 BrandProduct?                @relation(fields: [brandProductId], references: [id], onDelete: SetNull)
  optionGroupLinks             BranchMenuItemOptionGroup[]
  optionGroupMenuSources       BranchOptionGroupMenuItem[]
  orderItems                   OrderItem[]
  skewerOrderItems             SkewerOrderItem[]
  stock                        BranchMenuItemStock?
  branchMenuItemStockHistories BranchMenuItemStockHistory[]

  @@index([brandProductId])
}

model BranchMenuItemStock {
  id         String   @id @default(cuid())
  branchId   String
  menuItemId String   @unique
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt

  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem BranchMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model BranchMenuItemStockHistory {
  id               String   @id @default(cuid())
  branchId         String
  menuItemId       String
  quantity         Int
  type             String // "ADJUST", "SALE", "RESTOCK", "ISSUE"
  note             String?
  imageUrl         String?
  /// Groups lines from one staff submit (รับเข้า / จ่ายออก)
  batchId          String?
  /// When set, this line was cancelled (stock effect reversed)
  cancelledAt      DateTime?
  cancelNote       String?
  createdAt        DateTime @default(now())
  createdByStaffId String?

  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem       BranchMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdByStaff Staff?         @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([menuItemId])
  @@index([batchId])
  @@index([branchId, type, createdAt])
}

model MenuCategory {
  id          String           @id @default(cuid())
  branchId    String
  name        String
  sortOrder   Int              @default(0)
  /// When true, menu items in this category are not gated by BranchMenuItemStock
  stockExempt Boolean          @default(false)
  createdAt   DateTime         @default(now())
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems   BranchMenuItem[]

  @@unique([branchId, name])
}

/**
 * Copy pack code — paste into another branch to import menu/categories/options
 */
model BranchShareCode {
  id             String   @id @default(cuid())
  code           String   @unique
  sourceBranchId String
  createdAt      DateTime @default(now())
  sourceBranch   Branch   @relation(fields: [sourceBranchId], references: [id], onDelete: Cascade)
}

/**
 * Shared option heading library per branch
 */
model BranchOptionGroup {
  id                       String                      @id @default(cuid())
  branchId                 String
  name                     String
  mode                     OptionGroupMode             @default(MANUAL)
  required                 Boolean                     @default(false)
  /// Minimum selections (counting duplicates when allowDuplicateSelections)
  minSelect                Int                         @default(0)
  maxSelect                Int                         @default(1)
  allowDuplicateSelections Boolean                     @default(false)
  sortOrder                Int                         @default(0)
  createdAt                DateTime                    @default(now())
  branch                   Branch                      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  options                  BranchOption[]
  menuItemSources          BranchOptionGroupMenuItem[]
  menuItemLinks            BranchMenuItemOptionGroup[]
}

/// Menu items offered as selectable options (FROM_MENU mode)
model BranchOptionGroupMenuItem {
  id         String            @id @default(cuid())
  groupId    String
  menuItemId String
  sortOrder  Int               @default(0)
  isEnabled  Boolean           @default(true)
  priceDelta Decimal           @default(0) @db.Decimal(10, 2)
  createdAt  DateTime          @default(now())
  group      BranchOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  menuItem   BranchMenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([groupId, menuItemId])
  @@index([groupId])
}

model BranchOption {
  id         String            @id @default(cuid())
  groupId    String
  name       String
  priceDelta Decimal           @default(0) @db.Decimal(10, 2)
  createdAt  DateTime          @default(now())
  group      BranchOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model BranchMenuItemOptionGroup {
  id         String            @id @default(cuid())
  menuItemId String
  groupId    String
  createdAt  DateTime          @default(now())
  menuItem   BranchMenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group      BranchOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, groupId])
}

model DeliveryLocation {
  id              String  @id @default(cuid())
  branchId        String
  name            String
  deliveryFee     Decimal @default(0) @db.Decimal(10, 2)
  /// When true, customer must enter a full delivery address at checkout
  isCustomAddress Boolean @default(false)
  address         String?
  latitude        Float?
  longitude       Float?
  branch          Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders          Order[]
}

model Customer {
  id           String        @id @default(cuid())
  phone        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  orders       Order[]
  skewerOrders SkewerOrder[]
}

/// Pending Taximail OTP challenge for customer phone login
model CustomerOtpChallenge {
  id          String    @id @default(cuid())
  phone       String
  messageId   String
  otpRefNo    String?
  pendingName String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?

  @@index([phone, createdAt])
  @@index([messageId])
}

model Order {
  id                 String            @id @default(cuid())
  orderNumber        String            @unique
  /// Per-branch daily queue (1, 2, 3…) reset each operating day
  queueNumber        Int
  /// Operating / queue day for this branch (paired with queueNumber; not migrated for old rows)
  queueBusinessDate  DateTime          @db.Date
  customerId         String
  branchId           String
  fulfillmentType    FulfillmentType   @default(DELIVERY)
  deliveryLocationId String?
  addressDetail      String?
  /// Pin for custom / “อื่น” delivery — distance shown to staff
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  customerName       String            @default("")
  customerPhone      String            @default("")
  /// True when this was the customer's first order at this branch
  isNewCustomer      Boolean           @default(false)
  scheduledAt        DateTime?
  note               String?
  /// Snapshot of applied cart promo, e.g. "โปร 10+1 (−฿15)"
  promoSummary       String?
  /// Staff storefront packaging: cup size in oz (22 / 32)
  cupSizeOz          Int?
  /// Number of cups used for this order
  cupCount           Int?
  /// Number of bags (usually equals cupCount)
  bagCount           Int?
  paymentMethod      PaymentMethod     @default(CASH)
  /// Staff-selected channel; customer online orders are always ORDER_CUSTOMER
  salesChannel       SalesChannel      @default(STOREFRONT)
  deliveryFee        Decimal           @default(0) @db.Decimal(10, 2)
  discountAmount     Decimal           @default(0) @db.Decimal(10, 2)
  status             OrderStatus       @default(WAITING_FOR_STORE_ACCEPTANCE)
  cancelledAt        DateTime?
  /// Why the order was cancelled (customer or staff)
  cancelReason       String?
  /// Staff who keyed a walk-in order (null for customer online orders)
  createdByStaffId   String?
  /// Staff sales round this order belongs to (null for legacy rows)
  shiftId            String?
  /// Reference photo for rush “key later” orders
  photoUrl           String?
  /// True until staff finishes keying items from the photo (not counted as sales yet)
  awaitingPhotoKey   Boolean           @default(false)
  /// True after stock was deducted on accept / auto-accept
  stockDeducted      Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  customer           Customer          @relation(fields: [customerId], references: [id])
  branch             Branch            @relation(fields: [branchId], references: [id])
  deliveryLocation   DeliveryLocation? @relation(fields: [deliveryLocationId], references: [id])
  createdByStaff     Staff?            @relation("OrderCreatedByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  shift              BranchShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  consumableLines    OrderConsumableLine[]
  stockMovements     StockMovement[]

  @@unique([branchId, queueBusinessDate, queueNumber])
  @@index([branchId, queueBusinessDate])
  @@index([branchId, awaitingPhotoKey])
  @@index([shiftId])
}

/// Customer skewer-prep request (branch operatingMode = SKEWER); no queue/shift/price in v1
model SkewerOrder {
  id                   String            @id @default(cuid())
  orderNumber          String            @unique
  branchId             String
  customerId           String
  customerPhone        String            @default("")
  customerName         String            @default("")
  /// Calendar date the customer wants the skewers (Bangkok date stored as Date)
  requestedDate        DateTime          @db.Date
  addressText          String
  latitude             Float?
  longitude            Float?
  note                 String?
  status               SkewerOrderStatus @default(PENDING_CONFIRM)
  adminNote            String?
  confirmedAt          DateTime?
  confirmedByAdminId   String?
  cancelReason         String?
  cancelledAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  branch               Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer             Customer          @relation(fields: [customerId], references: [id])
  confirmedByAdmin     Admin?            @relation("SkewerOrderConfirmedByAdmin", fields: [confirmedByAdminId], references: [id], onDelete: SetNull)
  items                SkewerOrderItem[]

  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
}

model SkewerOrderItem {
  id                 String          @id @default(cuid())
  skewerOrderId      String
  branchMenuItemId   String?
  itemName           String
  requestedQuantity  Int
  confirmedQuantity  Int?
  skewerOrder        SkewerOrder     @relation(fields: [skewerOrderId], references: [id], onDelete: Cascade)
  branchMenuItem     BranchMenuItem? @relation(fields: [branchMenuItemId], references: [id], onDelete: SetNull)

  @@index([skewerOrderId])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  /// Nullable so admin can delete menu items; order history keeps itemName snapshot.
  branchMenuItemId String?
  itemName         String
  quantity         Int
  unitPrice        Decimal         @db.Decimal(10, 2)
  optionsText      String?
  optionsPrice     Decimal         @default(0) @db.Decimal(10, 2)
  /// Free pieces from promo packs (e.g. 10+1 → 1 per set)
  giftQuantity     Int             @default(0)
  note             String?
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchMenuItem   BranchMenuItem? @relation(fields: [branchMenuItemId], references: [id], onDelete: SetNull)
}

/// Brand-level SKU for SALE_ITEM / CONSUMABLE / EQUIPMENT
model BrandProduct {
  id                 String              @id @default(cuid())
  brandId            String
  sku                String?
  barcode            String?
  name               String
  stockType          StockType           @default(SALE_ITEM)
  category           String?
  imageUrl           String?
  description        String?
  unit               String              @default("ชิ้น")
  trackStock         Boolean             @default(true)
  trackLots          Boolean             @default(false)
  lowStockAlert      Int?
  costPrice          Decimal?            @db.Decimal(10, 2)
  sellingPrice       Decimal?            @db.Decimal(10, 2)
  isActive           Boolean             @default(true)
  equipmentStatus    EquipmentStatus?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  balances           StockBalance[]
  movements          StockMovement[]
  menuItems          BranchMenuItem[]
  transfers          StockTransfer[]
  countLines         StockCountLine[]
  lots               StockLot[]
  purchaseOrderLines PurchaseOrderLine[]
  recipeLines          ProductRecipeLine[] @relation("RecipeParent")
  usedInRecipes        ProductRecipeLine[] @relation("RecipeComponent")
  kitchenProductions   KitchenProduction[]
  kitchenComponents    KitchenProductionComponent[]
  branchStockRequests  BranchStockRequest[]

  @@unique([brandId, name])
  @@index([brandId, stockType])
  @@index([brandId, isActive])
  @@index([brandId, barcode])
}

model StockLocation {
  id             String            @id @default(cuid())
  brandId        String
  type           StockLocationType
  branchId       String?
  name           String
  createdAt      DateTime          @default(now())
  brand          Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  balances       StockBalance[]
  movementsFrom  StockMovement[]   @relation("StockMovementFrom")
  movementsTo    StockMovement[]   @relation("StockMovementTo")
  movementsAt    StockMovement[]   @relation("StockMovementAt")
  counts         StockCount[]
  lots           StockLot[]
  purchaseOrders PurchaseOrder[]
  kitchenProductions KitchenProduction[]

  @@unique([branchId])
  @@index([brandId, type])
}

model StockBalance {
  id              String        @id @default(cuid())
  stockLocationId String
  brandProductId  String
  quantity        Int           @default(0)
  updatedAt       DateTime      @updatedAt
  location        StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  product         BrandProduct  @relation(fields: [brandProductId], references: [id], onDelete: Cascade)

  @@unique([stockLocationId, brandProductId])
  @@index([brandProductId])
}

model StockLot {
  id              String          @id @default(cuid())
  brandId         String
  brandProductId  String
  stockLocationId String
  lotNumber       String
  expiresAt       DateTime?
  quantity        Int             @default(0)
  unitCost        Decimal?        @db.Decimal(10, 2)
  receivedAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product         BrandProduct    @relation(fields: [brandProductId], references: [id], onDelete: Cascade)
  location        StockLocation   @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  movements       StockMovement[]

  @@unique([stockLocationId, brandProductId, lotNumber])
  @@index([brandId, expiresAt])
  @@index([brandProductId, expiresAt])
}

model StockMovement {
  id               String            @id @default(cuid())
  brandId          String
  brandProductId   String
  type             StockMovementType
  quantity         Int
  beforeQty        Int?
  afterQty         Int?
  unitCost         Decimal?          @db.Decimal(10, 2)
  totalCost        Decimal?          @db.Decimal(10, 2)
  supplier         String?
  stockLocationId  String?
  fromLocationId   String?
  toLocationId     String?
  orderId          String?
  referenceType    String?
  referenceId      String?
  note             String?
  imageUrl         String?
  lotId            String?
  lotNumber        String?
  expiresAt        DateTime?
  createdByAdminId String?
  createdByStaffId String?
  createdAt        DateTime          @default(now())
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  product          BrandProduct      @relation(fields: [brandProductId], references: [id], onDelete: Cascade)
  stockLocation    StockLocation?    @relation("StockMovementAt", fields: [stockLocationId], references: [id], onDelete: SetNull)
  fromLocation     StockLocation?    @relation("StockMovementFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation       StockLocation?    @relation("StockMovementTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lot              StockLot?         @relation(fields: [lotId], references: [id], onDelete: SetNull)
  createdByAdmin   Admin?            @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByStaff   Staff?            @relation("StockMovementByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([brandId, createdAt])
  @@index([orderId])
  @@index([brandProductId, createdAt])
  @@index([stockLocationId, createdAt])
  @@index([type, createdAt])
  @@index([lotId])
}

model StockTransfer {
  id                String              @id @default(cuid())
  brandId           String
  kind              StockTransferKind   @default(WAREHOUSE_TO_BRANCH)
  branchId          String
  sourceBranchId    String?
  brandProductId    String
  quantity          Int
  status            StockTransferStatus @default(PENDING)
  note              String?
  lotNumber         String?
  expiresAt         DateTime?
  createdByAdminId  String?
  receivedByStaffId String?
  receivedQuantity  Int?
  varianceQuantity  Int?
  varianceNote      String?
  createdAt         DateTime            @default(now())
  receivedAt        DateTime?
  brand             Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branch            Branch              @relation("StockTransferDestination", fields: [branchId], references: [id], onDelete: Cascade)
  sourceBranch      Branch?             @relation("StockTransferSource", fields: [sourceBranchId], references: [id], onDelete: SetNull)
  product           BrandProduct        @relation(fields: [brandProductId], references: [id], onDelete: Cascade)
  createdByAdmin    Admin?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  receivedByStaff   Staff?              @relation("StockTransferReceivedBy", fields: [receivedByStaffId], references: [id], onDelete: SetNull)

  @@index([branchId, status, createdAt])
  @@index([sourceBranchId, status])
  @@index([brandId, status, createdAt])
  @@index([brandProductId])
}

model StockCount {
  id               String           @id @default(cuid())
  brandId          String
  branchId         String?
  shiftId          String?
  stockLocationId  String
  name             String
  type             StockCountType   @default(CUSTOM)
  status           StockCountStatus @default(DRAFT)
  startsAt         DateTime         @default(now())
  endsAt           DateTime?
  note             String?
  createdByAdminId String?
  createdByStaffId String?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift            BranchShift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  location         StockLocation    @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  createdByAdmin   Admin?           @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByStaff   Staff?           @relation("StockCountByStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  lines            StockCountLine[]

  @@index([brandId, status, createdAt])
  @@index([branchId, status])
  @@index([shiftId])
  @@index([stockLocationId])
}

model StockCountLine {
  id             String       @id @default(cuid())
  countId        String
  brandProductId String
  systemQty      Int
  countedQty     Int?
  openingQty     Int?
  addedQty       Int?
  salesQty       Int?
  wasteQty       Int?
  expectedQty    Int?
  varianceQty    Int?
  varianceReason String?
  note           String?
  count          StockCount   @relation(fields: [countId], references: [id], onDelete: Cascade)
  product        BrandProduct @relation(fields: [brandProductId], references: [id], onDelete: Cascade)

  @@unique([countId, brandProductId])
  @@index([brandProductId])
}

model Supplier {
  id             String          @id @default(cuid())
  brandId        String
  code           String?
  name           String
  phone          String?
  email          String?
  address        String?
  note           String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([brandId, name])
  @@index([brandId, isActive])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  brandId          String
  supplierId       String
  stockLocationId  String?
  orderNumber      String
  status           PurchaseOrderStatus @default(DRAFT)
  expectedAt       DateTime?
  note             String?
  orderedAt        DateTime?
  receivedAt       DateTime?
  createdByAdminId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  brand            Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location         StockLocation?      @relation(fields: [stockLocationId], references: [id], onDelete: SetNull)
  createdByAdmin   Admin?              @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  lines            PurchaseOrderLine[]

  @@unique([brandId, orderNumber])
  @@index([brandId, status, createdAt])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  brandProductId   String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal?      @db.Decimal(10, 2)
  note             String?
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          BrandProduct  @relation(fields: [brandProductId], references: [id], onDelete: Restrict)

  @@unique([purchaseOrderId, brandProductId])
  @@index([brandProductId])
}

model ProductRecipeLine {
  id                 String       @id @default(cuid())
  parentProductId    String
  componentProductId String
  quantityPerUnit    Decimal      @db.Decimal(12, 4)
  note               String?
  createdAt          DateTime     @default(now())
  parent             BrandProduct @relation("RecipeParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  component          BrandProduct @relation("RecipeComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([parentProductId, componentProductId])
  @@index([componentProductId])
}

/// Kitchen prep run: raw materials → finished skewers/sale items at warehouse
model KitchenProduction {
  id                  String                   @id @default(cuid())
  brandId             String
  stockLocationId     String
  finishedProductId   String
  /// Usable finished units added to warehouse stock
  quantityProduced    Int
  /// Finished units damaged during prep (not stocked)
  quantityWasted      Int                      @default(0)
  status              KitchenProductionStatus  @default(COMPLETED)
  note                String?
  lotNumber           String?
  completedAt         DateTime                 @default(now())
  createdByAdminId    String?
  createdAt           DateTime                 @default(now())
  brand               Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  location            StockLocation            @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  finishedProduct     BrandProduct             @relation(fields: [finishedProductId], references: [id], onDelete: Restrict)
  createdByAdmin      Admin?                   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  components          KitchenProductionComponent[]

  @@index([brandId, completedAt])
  @@index([finishedProductId, completedAt])
  @@index([status, completedAt])
}

model KitchenProductionComponent {
  id               String             @id @default(cuid())
  productionId     String
  brandProductId   String
  /// Planned from recipe × (produced + waste)
  quantityPlanned  Int
  /// Actually deducted
  quantityUsed     Int
  production       KitchenProduction  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  product          BrandProduct       @relation(fields: [brandProductId], references: [id], onDelete: Restrict)

  @@unique([productionId, brandProductId])
  @@index([brandProductId])
}

/// Branch asks kitchen/HQ for finished goods before production/shipping
model BranchStockRequest {
  id                 String                   @id @default(cuid())
  brandId            String
  branchId           String
  brandProductId     String
  quantityRequested  Int
  quantityFulfilled  Int                      @default(0)
  status             BranchStockRequestStatus @default(PENDING)
  note               String?
  adminNote          String?
  requestedByStaffId String?
  fulfilledByAdminId String?
  transferId         String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  fulfilledAt        DateTime?
  brand              Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  branch             Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product            BrandProduct             @relation(fields: [brandProductId], references: [id], onDelete: Restrict)
  requestedByStaff   Staff?                   @relation(fields: [requestedByStaffId], references: [id], onDelete: SetNull)
  fulfilledByAdmin   Admin?                   @relation("StockRequestFulfilledBy", fields: [fulfilledByAdminId], references: [id], onDelete: SetNull)

  @@index([brandId, status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([brandProductId])
}

model BranchNonMenuItem {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  description String?
  unit        String   @default("ชิ้น")
  price       Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  stockType   String   // "CONSUMABLE" | "EQUIPMENT"
  quantity    Int      @default(0)
  /// Show on staff key-order “เลือกสินค้าสิ้นเปลือง”
  showOnKeyOrder Boolean @default(false)
  /// Sort among key-order consumables (lower first)
  keyOrderSortOrder Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  histories   BranchNonMenuItemHistory[]
  orderLines  OrderConsumableLine[]

  @@index([branchId])
  @@index([branchId, showOnKeyOrder])
}

/// Consumables (cups/bags/etc.) used on a staff order — deducted from BranchNonMenuItem
model OrderConsumableLine {
  id                  String @id @default(cuid())
  orderId             String
  branchNonMenuItemId String
  /// Snapshot name at order time
  itemName            String
  quantity            Int
  unit                String @default("ใบ")
  order               Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item                BranchNonMenuItem @relation(fields: [branchNonMenuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([branchNonMenuItemId])
}

model BranchNonMenuItemHistory {
  id                  String   @id @default(cuid())
  branchNonMenuItemId String
  quantity            Int
  type                String   // "ADJUST", "STOCK_IN", "ISSUE"
  note                String?
  imageUrl            String?
  /// Groups lines from one staff submit (รับเข้า / จ่ายออก)
  batchId             String?
  cancelledAt         DateTime?
  cancelNote          String?
  createdAt           DateTime @default(now())
  createdByStaffId    String?

  item                BranchNonMenuItem @relation(fields: [branchNonMenuItemId], references: [id], onDelete: Cascade)
  createdByStaff      Staff?            @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([branchNonMenuItemId])
  @@index([batchId])
  @@index([type, createdAt])
}

/// Branch operating expense (cash out) — separate from stock movements
model BranchExpense {
  id               String             @id @default(cuid())
  branchId         String
  shiftId          String?
  title            String
  amount           Decimal            @db.Decimal(12, 2)
  /// @deprecated kept for existing rows; new records use IMMEDIATE
  paymentMode      ExpensePaymentMode @default(IMMEDIATE)
  schedule         ExpenseSchedule?
  payChannel       ExpensePayChannel  @default(CASH)
  /// Bangkok calendar date of the expense
  expenseDate      DateTime           @db.Date
  note             String?
  createdByStaffId String?
  createdByAdminId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift            BranchShift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdByStaff   Staff?             @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  createdByAdmin   Admin?             @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([branchId, expenseDate])
  @@index([branchId, payChannel])
  @@index([createdByStaffId])
  @@index([createdByAdminId])
}
